# Copy to .env and fill in before running `docker compose up`.
# These are consumed by docker-compose.yml for the jk-crm-api service.

JWT_SECRET="change-me-in-production-32-chars-min"
JWT_EXPIRES_IN="8h"

RESEND_API_KEY="re_your_api_key_here"
RESEND_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

FROM_EMAIL="noreply@yourdomain.com"
FROM_NAME="Your name here"
DAILY_EMAIL_LIMIT=100

FRONTEND_URL="http://localhost:8080"

# Bootstrap: only used when the database has NO users yet.
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="change-me-on-first-login"
